Screen {
    overflow: hidden;
}

HeaderContainer {
    layout: horizontal;
    height: 4;
    background: $surface;
}

#bin_date {
    padding: 0 2;
    width: 1fr;
}

#bin_clock {
    padding: 0 2;
    width: 1fr;
    content-align: right middle;
}

#bushido_img {
    width: 8;
    height: 4;
    padding: 0 2;
    content-align: center middle;
}

#log_unit_dialog {
    padding: 0 2 1 2;

    border: solid #16404a;
    color: #b8dce2;
}

#command_line {
    width: 80%;
    height: 3;
    border: solid #16404a;
    background: #071116;
}

#command_line:focus-within {
    border: solid #45e6f2;
}

#prompt {
    width: 3;
    height: 1fr;
    color: #45e6f2;
    text-style: bold;
}

#command_input {
    width: 1fr;
    height: 1fr;
    border: none;
    background: transparent;
    color: #72f3ff;
}

#terminal_header {
    width: 100%;
    height: 3;

    padding: 1 0;
    color: #72f3ff;
    background: #071116;

    text-style: bold;
}


.separator {
    height: 1;
    color: #16404a;
}

#text_input {
    width: 100%;
    height: 3;

    padding: 0 1;

    background: #071116;
    color: #72f3ff;

    border: solid #16404a;
}

#text_input:focus {
    border: solid #45e6f2;
}

#text_input > .input--placeholder {
    color: #608890;
}

#text_input > .input--suggestion {
    color: #35bfc5;
    text-style: dim;
}

#terminal_status {
    width: 100%;
    height: 2;

    margin-top: 1;

    color: #608890;
    text-align: right;
}